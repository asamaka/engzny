{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 120 }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/skytower",
      "status": 308,
      "headers": { "Location": "/skytower/" }
    },
    {
      "src": "/skytower/",
      "dest": "/public/skytower/index.html"
    },
    {
      "src": "/skytower/(.+)",
      "dest": "/public/skytower/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
